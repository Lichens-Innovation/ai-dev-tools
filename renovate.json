{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>Lichens-Innovation/lichens-dependency-scan//renovate-presets/default",
    "local>Lichens-Innovation/renovate-runner:claude-cve-gate",
    "local>Lichens-Innovation/renovate-runner:automerge-routine"
  ],
  "packageRules": [
    {
      "description": "Keep @types/node on the Node major we run (node:24 in the Dockerfiles).",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    },
    {
      "description": "Keep CI's node-version on the Node major we run (node:24 in the Dockerfiles). Lift together with the Dockerfiles and the @types/node rule.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["node"],
      "allowedVersions": "<25"
    }
  ]
}
