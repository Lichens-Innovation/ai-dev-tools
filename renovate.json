{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>Lichens-Innovation/renovate-runner",
    "local>Lichens-Innovation/renovate-runner:claude-cve-gate",
    "local>Lichens-Innovation/renovate-runner:automerge-routine"
  ],
  "packageRules": [
    {
      "description": "Keep @types/node on the Node major we run (node:24 in the Dockerfiles).",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    }
  ]
}
